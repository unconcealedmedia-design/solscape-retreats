---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Geneva Retreat — SolScape Retreats" description="Surrounded by the stillness of the mountains just beyond Geneva, this retreat offers space to breathe deeply, reconnect, and return to balance. July 2027.">

  <!-- ============================================================
       SECTION: Hero
       ============================================================ -->
  <div class="detail-hero">
    <div class="hero-bg" style="background-image: url('https://images.unsplash.com/photo-1506905925346-21bda4d32df4?auto=format&fit=crop&w=1920&q=80');"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="sub">Swiss Alps &nbsp;·&nbsp; Geneva</p>
      <h1>Geneva<br>Retreat</h1>
      <img src={`${base}/images/branding/solscape-logo.png`} class="hero-brand-mark" alt="SolScape">
    </div>
  </div>

  <!-- ============================================================
       SECTION: Overview
       ============================================================ -->
  <section style="background: var(--cream);">
    <div class="container" style="max-width: 760px; text-align: center;">
      <p class="section-label">Coming Soon</p>
      <h2 class="section-title">Space to breathe deeply and <em>return to balance</em></h2>
      <div class="divider" style="margin: 28px auto;"></div>
      <p style="font-size: 1.05rem; line-height: 1.9; color: var(--mocha); margin-bottom: 24px;">Details coming soon. The stillness of the Swiss Alps just beyond Geneva — mountain air, alpine walks, and space to breathe deeply and reconnect. Register your interest below and be the first to know when it's revealed.</p>
      <p style="font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 1.2rem; color: var(--terra); letter-spacing: 0.03em;">reflection</p>
    </div>
  </section>

  <!-- ============================================================
       SECTION: Private Retreats
       ============================================================ -->
  <section style="background: var(--charcoal); padding: 80px 40px;">
    <div class="container" style="max-width: 760px; text-align: center;">
      <p class="section-label" style="color: var(--terra);">Bespoke Experiences</p>
      <h2 class="section-title" style="color: var(--linen);">Private Retreats <em style="color: var(--gold);">available upon request</em></h2>
      <div class="divider" style="margin: 28px auto; background: var(--terra); opacity: 0.45;"></div>
      <p style="font-size: 0.95rem; line-height: 1.9; color: var(--sand); margin-bottom: 32px;">Looking for a fully bespoke experience for your group? We create private SolScape retreats tailored entirely around you — your dates, your destination, your group. Reach out and let's design something unforgettable together.</p>
      <div style="display: flex; gap: 14px; flex-wrap: wrap; justify-content: center;">
        <a href="https://ig.me/m/solscape_retreats" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Message us on Instagram</a>
        <a href="mailto:solscaperetreats@gmail.com?subject=Retreat%20Enquiry" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">Email us</a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION: Other Retreats
       ============================================================ -->
  <section class="other-retreats">
    <div class="container">
      <p class="section-label">More Destinations</p>
      <h2 class="section-title">Explore other <em>retreats</em></h2>
      <div class="other-retreat-cards">
        <div class="card">
          <div class="card-banner" style="background-image: url('https://images.unsplash.com/photo-1499678329028-101435549a4e?auto=format&fit=crop&w=1200&q=80');">
            <div class="card-location"><small>Southern France</small>Provence</div>
          </div>
          <div class="card-body">
            <p class="card-theme-name">SoFen</p>
            <p class="card-dates"><span class="card-status-dot"></span>Upcoming</p>
            <p class="card-desc">Lavender fields, local markets, and slow movement beneath the spring light of Provence.</p>
            <a href={`${base}/retreats/provence`} class="card-link">Retreat details →</a>
          </div>
        </div>
        <div class="card">
          <div class="card-banner" style="background-image: url('https://images.unsplash.com/photo-1504457047772-27faf1c00561?auto=format&fit=crop&w=1200&q=80');">
            <div class="card-location"><small>Destination TBA</small>Exotic</div>
          </div>
          <div class="card-body">
            <p class="card-theme-name">expansive</p>
            <p class="card-dates">Coming Soon</p>
            <p class="card-desc">A stunning location, off the beaten track. Details coming soon.</p>
            <a href={`${base}/retreats/exotic`} class="card-link">Retreat details →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
