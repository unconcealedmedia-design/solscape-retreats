---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Provence Retreat — SolScape Retreats" description="Nestled in the rolling countryside of Provence, this retreat is an invitation to slow down and savor life's simple beauty. April 2027.">

  <!-- ============================================================
       SECTION: Hero
       ============================================================ -->
  <div class="detail-hero">
    <div class="hero-bg" style="background-image: url('https://images.unsplash.com/photo-1499678329028-101435549a4e?auto=format&fit=crop&w=1920&q=80');"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="sub">Southern France &nbsp;·&nbsp; Provence</p>
      <h1>Provence<br>Retreat</h1>
      <img src={`${base}/images/branding/solscape-logo.png`} class="hero-brand-mark" alt="SolScape">
    </div>
  </div>

  <!-- ============================================================
       SECTION: Overview
       ============================================================ -->
  <section style="background: var(--cream);">
    <div class="container" style="max-width: 760px; text-align: center;">
      <p class="section-label">Coming Soon</p>
      <h2 class="section-title">Slow down and savor <em>life's simple beauty</em></h2>
      <div class="divider" style="margin: 28px auto;"></div>
      <p style="font-size: 1.05rem; line-height: 1.9; color: var(--mocha); margin-bottom: 24px;">Details coming soon. Rolling countryside, lavender fields, and timeless hilltop villages — an invitation to slow down and savor life's simple beauty. Register your interest below to be the first to receive dates and details.</p>
      <p style="font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 1.2rem; color: var(--terra); letter-spacing: 0.03em;">savor</p>
    </div>
  </section>

  <!-- ============================================================
       SECTION: Private Retreats
       ============================================================ -->
  <section style="background: var(--charcoal); padding: 80px 40px;">
    <div class="container" style="max-width: 760px; text-align: center;">
      <p class="section-label" style="color: var(--terra);">Bespoke Experiences</p>
      <h2 class="section-title" style="color: var(--linen);">Private Retreats <em style="color: var(--gold);">available upon request</em></h2>
      <div class="divider" style="margin: 28px auto; background: var(--terra); opacity: 0.45;"></div>
      <p style="font-size: 0.95rem; line-height: 1.9; color: var(--sand); margin-bottom: 32px;">Looking for a fully bespoke experience for your group? We create private SolScape retreats tailored entirely around you — your dates, your destination, your group. Reach out and let's design something unforgettable together.</p>
      <div style="display: flex; gap: 14px; flex-wrap: wrap; justify-content: center;">
        <a href="https://ig.me/m/solscape_retreats" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Message us on Instagram</a>
        <a href="mailto:solscaperetreats@gmail.com?subject=Retreat%20Enquiry" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">Email us</a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION: Other Retreats
       ============================================================ -->
  <section class="other-retreats">
    <div class="container">
      <p class="section-label">More Destinations</p>
      <h2 class="section-title">Explore other <em>retreats</em></h2>
      <div class="other-retreat-cards">
        <div class="card">
          <div class="card-banner" style="background-image: url('https://images.unsplash.com/photo-1539020140153-e479b8c22e70?auto=format&fit=crop&w=1200&q=80');">
            <div class="card-location"><small>Atlas Mountains</small>Morocco</div>
          </div>
          <div class="card-body">
            <p class="card-theme-name">Rooted</p>
            <p class="card-dates"><span class="card-status-dot"></span>Upcoming</p>
            <p class="card-desc">Mountain air, quiet terraces, and movement woven into the warmth of Morocco.</p>
            <a href={`${base}/retreats/morocco`} class="card-link">Retreat details →</a>
          </div>
        </div>
        <div class="card">
          <div class="card-banner" style="background-image: url('https://images.unsplash.com/photo-1506905925346-21bda4d32df4?auto=format&fit=crop&w=1200&q=80');">
            <div class="card-location"><small>Swiss Alps</small>Geneva</div>
          </div>
          <div class="card-body">
            <p class="card-theme-name">reflection</p>
            <p class="card-dates"><span class="card-status-dot"></span>Upcoming</p>
            <p class="card-desc">Alpine air, mountain stillness, and restorative movement shaped by the rhythm of summer in the Alps.</p>
            <a href={`${base}/retreats/geneva`} class="card-link">Retreat details →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
