---
import Layout from '../../../layouts/Layout.astro';
import RetreatGallery from '../../../components/RetreatGallery.astro';
const base = import.meta.env.BASE_URL.replace(/\/+$/, "");

// Room galleries — image files live in /images/greece/rooms/<slug>/.
// Paths are built base-aware below so they survive the GitHub Pages sub-path,
// then serialized into a data attribute the shared lightbox reads at runtime.
const rooms = [
  {
    name: 'Suite with Sea View',
    slug: 'suite-sea-view',
    images: [
      { file: '1.webp', alt: 'Suite with Sea View — twin bedroom with sea view at Brazzo di Maina' },
      { file: '2.webp', alt: 'Suite with Sea View — second view of the twin bedroom' },
      { file: 'bathroom.webp', alt: 'Suite with Sea View — en-suite bathroom' },
    ],
  },
  {
    name: 'Grand Suite with Sea View',
    slug: 'grand-suite',
    images: [
      { file: '1.webp', alt: 'Grand Suite with Sea View — spacious suite with sitting area' },
      { file: '2.webp', alt: 'Grand Suite with Sea View — second view of the suite' },
      { file: 'bathroom.webp', alt: 'Grand Suite with Sea View — en-suite bathroom' },
    ],
  },
  {
    name: 'Premium Suite with Jetted Tub & Sea View',
    slug: 'premium-suite',
    images: [
      { file: '1.webp', alt: 'Premium Suite — indoor living space with jetted tub and sea view' },
      { file: 'bathroom.webp', alt: 'Premium Suite — bathroom' },
      { file: 'outdoor.webp', alt: 'Premium Suite — private outdoor area' },
    ],
  },
  {
    name: 'Executive Suite with Sea View',
    slug: 'executive-suite',
    images: [
      { file: '1.webp', alt: 'Executive Suite — two-bedroom suite with sea view' },
      { file: '2.webp', alt: 'Executive Suite — second view of the suite' },
      { file: '3.webp', alt: 'Executive Suite — living area' },
      { file: '4.webp', alt: 'Executive Suite — additional view' },
    ],
  },
];

// Build a base-aware gallery payload for a room (consumed by the lightbox JS).
const roomGallery = (room) => JSON.stringify({
  name: room.name,
  images: room.images.map((im) => ({
    src: `${base}/images/greece/rooms/${room.slug}/${im.file}`,
    alt: im.alt,
  })),
});

// "The Property" gallery — pool and dining shots.
const property = [
  { file: 'pool-1.webp', alt: 'Outdoor pool area at Brazzo di Maina, looking toward the sea' },
  { file: 'pool-2.webp', alt: 'Outdoor pool area with loungers and Mediterranean greenery' },
  { file: 'pool-3.webp', alt: 'Outdoor pool area at golden hour' },
  { file: 'dining-1.webp', alt: 'Outdoor dining area set for a shared Mediterranean meal' },
];
const propertyGallery = JSON.stringify({
  name: 'The Property',
  images: property.map((p) => ({ src: `${base}/images/greece/property/${p.file}`, alt: p.alt })),
});
---
<Layout title="Greece Retreat — SolScape Retreats" description="Five days on the coast of the Mani Peninsula — yoga, barre, nourishing meals, and time to explore at a relaxed pace. Mani, September 27 – October 1, 2026.">

  <!-- ============================================================
       SECTION: Hero
       ============================================================ -->
  <div class="detail-hero">
    <div class="hero-bg" style={`background-image: url('${base}/images/greece/property/pool-3.webp');`}></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="sub">The Mani Peninsula &nbsp;·&nbsp; Greece</p>
      <h1>Mani<br>Retreat</h1>
      <div class="dates-badge">September 27 – October 1, 2026 &nbsp;·&nbsp; Retreat Complete</div>
      <img src={`${base}/images/branding/solscape-logo.png`} class="hero-brand-mark" alt="SolScape">
    </div>
  </div>

  <!-- ============================================================
       SECTION: Overview
       ============================================================ -->
  <section style="background: var(--cream);">
    <div class="container">
      <div class="overview-grid">
        <div class="overview-text">
          <p class="section-label">Overview</p>
          <h2 class="section-title">Between the sea and the <em>timeless landscape</em></h2>
          <div class="divider"></div>
          <p>Five days on the coast, designed to create space for movement, rest, connection, and exploration. Each day combines yoga, barre, nourishing meals, and time to experience the surrounding landscape at a relaxed pace.</p>
        </div>
        <div>
          <div class="facts-card">
            <h4>Retreat at a Glance</h4>
            <div class="fact-row">
              <span class="fact-label">Dates</span>
              <span class="fact-value">September 27 – October 1, 2026</span>
            </div>
            <div class="fact-row">
              <span class="fact-label">Duration</span>
              <span class="fact-value">5 days / 4 nights</span>
            </div>
            <div class="fact-row">
              <span class="fact-label">Location</span>
              <span class="fact-value">The Mani Peninsula, Greece</span>
            </div>
            <div class="fact-row">
              <span class="fact-label">Level</span>
              <span class="fact-value">All levels welcome</span>
            </div>
            <div class="fact-row">
              <span class="fact-label">Theme</span>
              <span class="fact-value" style="font-family: 'Cormorant Garamond', serif; font-style: italic; color: var(--terra);">exhale</span>
            </div>
            <div class="fact-row">
              <span class="fact-label">Status</span>
              <span class="fact-value" style="color: var(--mocha);">Complete</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION: Retreat Gallery — photos from the retreat itself.
       List: content/retreat-galleries/greece.json
       Files: public/images/greece/retreat-gallery/
       Hidden on the live site until the first photo is listed.
       ============================================================ -->
  <RetreatGallery retreat="greece" place="the Mani" />

  <!-- ============================================================
       SECTION: The Property
       ============================================================ -->
  <section style="background: var(--cream);">
    <div class="container">
      <div style="text-align: center; max-width: 720px; margin: 0 auto;">
        <p class="section-label">The Property</p>
        <h2 class="section-title">Brazzo di <em>Maina</em></h2>
        <div class="divider" style="margin: 28px auto;"></div>
        <p style="font-size: 0.95rem; line-height: 1.9; color: var(--mocha);">A quiet stone retreat above the Mani coast — a sea-facing pool, shaded terraces, and a long table set for slow, shared meals.</p>
      </div>
      <div class="property-gallery" data-gallery={propertyGallery}>
        {property.map((p, i) => (
          <button type="button" class="property-item js-gallery-open" data-start={i} aria-label={`Open photo: ${p.alt}`}>
            <img src={`${base}/images/greece/property/${p.file}`} alt={p.alt} loading="lazy">
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION: The Experience
       ============================================================ -->
  <section style="background: var(--linen);">
    <div class="container">
      <div style="text-align: center; max-width: 720px; margin: 0 auto 8px;">
        <p class="section-label" style="margin-bottom: 20px;">The Experience</p>
        <h2 class="section-title" style="letter-spacing: 0.12em;">Move &nbsp;·&nbsp; Rest &nbsp;·&nbsp; Explore &nbsp;·&nbsp; <em>Reconnect</em></h2>
        <div class="divider" style="margin: 28px auto;"></div>
      </div>
      <div class="offerings-grid">
        <div class="offering-card">
          <h3>Accommodation</h3>
          <p>Elegant stone suites designed for rest, comfort, and connection.</p>
        </div>
        <div class="offering-card">
          <h3>Movement</h3>
          <p>Movement designed to meet you where you are.</p>
        </div>
        <div class="offering-card">
          <h3>Explore</h3>
          <p>Stone villages. Coastal trails. Hidden discoveries.</p>
        </div>
        <div class="offering-card">
          <h3>Nourish</h3>
          <p>Mediterranean meals. Shared around the table.</p>
        </div>
        <div class="offering-card">
          <h3>Unwind</h3>
          <p>Space to slow down and simply be.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION: Your Hosts
       ============================================================ -->
  <section style="background: var(--charcoal);">
    <div class="container" style="max-width: 760px; text-align: center;">
      <p class="section-label" style="color: var(--gold);">Your Hosts</p>
      <h2 class="section-title" style="color: var(--linen);">Led by <em style="color: var(--gold);">Nada &amp; Samantha</em></h2>
      <div class="divider" style="margin: 28px auto;"></div>
      <p style="font-size: 0.95rem; line-height: 1.9; color: var(--sand);">SolScape is led by: Nada and Samantha.<br>Together, they bring decades of experience in movement, wellness, and creating retreats that balance structure with freedom. Their approach is simple: create beautiful spaces where people can reconnect with themselves, move in ways that feel good, and share meaningful experiences with others.</p>
    </div>
  </section>

  <!-- ============================================================
       SECTION: Included / Not Included
       ============================================================ -->
  <section style="background: var(--cream);">
    <div class="container">
      <p class="section-label">What's Covered</p>
      <h2 class="section-title">Your SolScape <em>experience</em></h2>
      <div class="inc-exc-grid">
        <div class="inc-list">
          <h4>Included</h4>
          <ul>
            <li>Four nights accommodation at Brazzo di Maina</li>
            <li>Daily yoga and barre sessions</li>
            <li>Daily breakfast</li>
            <li>All group lunches and dinners</li>
            <li>Guided excursions and experiences</li>
            <li>Internal transfers on excursion days</li>
            <li>Welcome gift</li>
            <li>Time to relax, explore, and enjoy the surroundings</li>
          </ul>
        </div>
        <div class="exc-list">
          <h4>Not Included</h4>
          <ul>
            <li>Flights</li>
            <li>Airport transfers</li>
            <li>Travel insurance</li>
            <li>Personal expenses</li>
            <li>Optional activities outside the retreat itinerary</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION: Accommodation
       ============================================================ -->
  <section style="background: var(--linen);">
    <div class="container">
      <p class="section-label">Accommodation</p>
      <h2 class="section-title">Where we <em>stayed</em></h2>
      <div class="offerings-grid" style="margin-top: 48px;">
        <div class="offering-card">
          <img class="room-thumb" src={`${base}/images/greece/rooms/${rooms[0].slug}/${rooms[0].images[0].file}`} alt={rooms[0].images[0].alt} loading="lazy">
          <h3>Suite with Sea View</h3>
          <p>Twin beds. Perfect for friends sharing. Two equal twin beds, sea views, traditional Mani architecture.</p>
          <button type="button" class="view-room-btn js-gallery-open" data-gallery={roomGallery(rooms[0])}>View Room <span aria-hidden="true">→</span></button>
        </div>
        <div class="offering-card">
          <img class="room-thumb" src={`${base}/images/greece/rooms/${rooms[1].slug}/${rooms[1].images[0].file}`} alt={rooms[1].images[0].alt} loading="lazy">
          <h3>Grand Suite with Sea View</h3>
          <p>Spacious 50 sqm suite with sea views, sitting area, private balcony, and sofa-bed option.</p>
          <button type="button" class="view-room-btn js-gallery-open" data-gallery={roomGallery(rooms[1])}>View Room <span aria-hidden="true">→</span></button>
        </div>
        <div class="offering-card">
          <img class="room-thumb" src={`${base}/images/greece/rooms/${rooms[2].slug}/${rooms[2].images[0].file}`} alt={rooms[2].images[0].alt} loading="lazy">
          <h3>Premium Suite with Jetted Tub &amp; Sea View</h3>
          <p>Our most spacious accommodation, featuring a private jetted tub, sea views, and generous indoor living space.</p>
          <button type="button" class="view-room-btn js-gallery-open" data-gallery={roomGallery(rooms[2])}>View Room <span aria-hidden="true">→</span></button>
        </div>
        <div class="offering-card">
          <img class="room-thumb" src={`${base}/images/greece/rooms/${rooms[3].slug}/${rooms[3].images[0].file}`} alt={rooms[3].images[0].alt} loading="lazy">
          <h3>Executive Suite with Sea View, 2 Bedrooms</h3>
          <p>A spacious 60 sqm suite featuring two bedrooms, two bathrooms, sea views, a kitchen, and a shared living area.</p>
          <button type="button" class="view-room-btn js-gallery-open" data-gallery={roomGallery(rooms[3])}>View Room <span aria-hidden="true">→</span></button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION: Other Retreats
       ============================================================ -->
  <section class="other-retreats">
    <div class="container">
      <p class="section-label">More Destinations</p>
      <h2 class="section-title">Explore other <em>retreats</em></h2>
      <div class="other-retreat-cards">
        <div class="card">
          <div class="card-banner" style="background-image: url('https://images.unsplash.com/photo-1523805009345-7448845a9e53?auto=format&fit=crop&w=1200&q=80');">
            <div class="card-location"><small>East Africa</small>Kenya</div>
          </div>
          <div class="card-body">
            <p class="card-theme-name">wander</p>
            <p class="card-dates"><span class="card-status-dot"></span>Upcoming</p>
            <p class="card-desc">Wide-open landscapes, early morning movement, and days shaped by the rhythm of the wild.</p>
            <a href={`${base}/retreats/kenya`} class="card-link">Retreat details →</a>
          </div>
        </div>
        <div class="card">
          <div class="card-banner" style="background-image: url('https://images.unsplash.com/photo-1539020140153-e479b8c22e70?auto=format&fit=crop&w=1200&q=80');">
            <div class="card-location"><small>Atlas Mountains</small>Morocco</div>
          </div>
          <div class="card-body">
            <p class="card-theme-name">Rooted</p>
            <p class="card-dates"><span class="card-status-dot"></span>Upcoming</p>
            <p class="card-desc">Mountain air, quiet terraces, and movement woven into the warmth of Morocco.</p>
            <a href={`${base}/retreats/morocco`} class="card-link">Retreat details →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
