---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Greece Retreat — SolScape Retreats" description="Five days on the coast of the Peloponnese — yoga, barre, nourishing meals, and time to explore at a relaxed pace. Mani, September 27 – October 1, 2026.">

  <!-- ============================================================
       SECTION: Hero
       ============================================================ -->
  <div class="detail-hero">
    <div class="hero-bg" style="background-image: url('https://images.unsplash.com/photo-1533105079780-92b9be482077?auto=format&fit=crop&w=1920&q=80');"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="sub">Peloponnese &nbsp;·&nbsp; Greece</p>
      <h1>Mani<br>Retreat</h1>
      <div class="dates-badge">September 27 – October 1, 2026 &nbsp;·&nbsp; 4 Nights</div>
      <img src={`${base}/images/branding/solscape-logo.png`} class="hero-brand-mark" alt="SolScape">
    </div>
  </div>

  <!-- ============================================================
       SECTION: Overview
       ============================================================ -->
  <section style="background: var(--cream);">
    <div class="container">
      <div class="overview-grid">
        <div class="overview-text">
          <p class="section-label">Overview</p>
          <h2 class="section-title">Between the sea and the <em>timeless landscape</em></h2>
          <div class="divider"></div>
          <p>Five days on the coast, designed to create space for movement, rest, connection, and exploration. Each day combines yoga, barre, nourishing meals, and time to experience the surrounding landscape at a relaxed pace.</p>
          <p>Whether you're coming alone or with a friend, this retreat is designed to meet you where you are. No prior yoga or barre experience is required.</p>
        </div>
        <div>
          <div class="facts-card">
            <h4>Retreat at a Glance</h4>
            <div class="fact-row">
              <span class="fact-label">Dates</span>
              <span class="fact-value">September 27 – October 1, 2026</span>
            </div>
            <div class="fact-row">
              <span class="fact-label">Duration</span>
              <span class="fact-value">5 days / 4 nights</span>
            </div>
            <div class="fact-row">
              <span class="fact-label">Location</span>
              <span class="fact-value">Mani, Peloponnese</span>
            </div>
            <div class="fact-row">
              <span class="fact-label">Price</span>
              <span class="fact-value">€1,590 – €2,690 pp</span>
            </div>
            <div class="fact-row">
              <span class="fact-label">Level</span>
              <span class="fact-value">All levels welcome</span>
            </div>
            <div class="fact-row">
              <span class="fact-label">Theme</span>
              <span class="fact-value" style="font-family: 'Cormorant Garamond', serif; font-style: italic; color: var(--terra);">exhale</span>
            </div>
            <div class="fact-row">
              <span class="fact-label">Status</span>
              <span class="fact-value" style="color: var(--terra); font-weight: 500;">Now open for booking</span>
            </div>
            <a href="#booking" class="btn btn-primary">Enquire Now</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION: The Experience
       ============================================================ -->
  <section style="background: var(--linen);">
    <div class="container">
      <div style="text-align: center; max-width: 720px; margin: 0 auto 8px;">
        <p class="section-label" style="margin-bottom: 20px;">The Experience</p>
        <h2 class="section-title" style="letter-spacing: 0.12em;">Move &nbsp;·&nbsp; Rest &nbsp;·&nbsp; Explore &nbsp;·&nbsp; <em>Reconnect</em></h2>
        <div class="divider" style="margin: 28px auto;"></div>
      </div>
      <div class="offerings-grid">
        <div class="offering-card">
          <h3>Accommodation</h3>
          <p>Elegant stone suites designed for rest, comfort, and connection.</p>
        </div>
        <div class="offering-card">
          <h3>Movement</h3>
          <p>Movement designed to meet you where you are.</p>
        </div>
        <div class="offering-card">
          <h3>Explore</h3>
          <p>Stone villages. Coastal trails. Hidden discoveries.</p>
        </div>
        <div class="offering-card">
          <h3>Nourish</h3>
          <p>Mediterranean meals. Shared around the table.</p>
        </div>
        <div class="offering-card">
          <h3>Unwind</h3>
          <p>Space to slow down and simply be.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION: Your Hosts
       ============================================================ -->
  <section style="background: var(--charcoal);">
    <div class="container" style="max-width: 760px; text-align: center;">
      <p class="section-label" style="color: var(--gold);">Your Hosts</p>
      <h2 class="section-title" style="color: var(--linen);">Led by <em style="color: var(--gold);">Nada &amp; Samantha</em></h2>
      <div class="divider" style="margin: 28px auto;"></div>
      <p style="font-size: 0.95rem; line-height: 1.9; color: var(--sand);">SolScape Retreats is led by Nada Sakati and Samantha Howick. Together, they bring decades of experience in movement, wellness, and creating retreats that balance structure with freedom. Their approach is simple: create beautiful spaces where people can reconnect with themselves, move in ways that feel good, and share meaningful experiences with others.</p>
    </div>
  </section>

  <!-- ============================================================
       SECTION: Included / Not Included
       ============================================================ -->
  <section style="background: var(--cream);">
    <div class="container">
      <p class="section-label">What's Covered</p>
      <h2 class="section-title">Included &amp; <em>not included</em></h2>
      <div class="inc-exc-grid">
        <div class="inc-list">
          <h4>Included</h4>
          <ul>
            <li>Four nights accommodation at Brazzo di Maina</li>
            <li>Daily yoga and barre sessions</li>
            <li>Daily breakfast</li>
            <li>All group lunches and dinners</li>
            <li>Guided excursions and experiences</li>
            <li>Internal transfers on excursion days</li>
            <li>Welcome gift</li>
            <li>Time to relax, explore, and enjoy the surroundings</li>
          </ul>
        </div>
        <div class="exc-list">
          <h4>Not Included</h4>
          <ul>
            <li>Flights</li>
            <li>Airport transfers</li>
            <li>Travel insurance</li>
            <li>Personal expenses</li>
            <li>Optional activities outside the retreat itinerary</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION: Accommodation & Pricing
       ============================================================ -->
  <section style="background: var(--linen);">
    <div class="container">
      <p class="section-label">Accommodation &amp; Pricing</p>
      <h2 class="section-title">Choose your <em>room</em></h2>
      <div class="offerings-grid" style="margin-top: 48px;">
        <div class="offering-card">
          <h3>Suite with Sea View</h3>
          <p style="color: var(--terra); font-size: 0.95rem; margin-bottom: 10px;">Sharing €1,590 pp</p>
          <p style="margin-bottom: 14px;"><span class="tag">2 rooms</span></p>
          <p>Twin beds. Perfect for friends sharing. Two equal twin beds, sea views, traditional Mani architecture.</p>
        </div>
        <div class="offering-card">
          <h3>Grand Suite with Sea View</h3>
          <p style="color: var(--terra); font-size: 0.95rem; margin-bottom: 10px;">Sharing €1,890 pp &nbsp;/&nbsp; Single €2,490 pp</p>
          <p style="margin-bottom: 14px;"><span class="tag">2 rooms</span></p>
          <p>Spacious 50 sqm suite with sea views, sitting area, private balcony, and sofa-bed option.</p>
        </div>
        <div class="offering-card">
          <h3>Premium Suite with Jetted Tub &amp; Sea View</h3>
          <p style="color: var(--terra); font-size: 0.95rem; margin-bottom: 10px;">Sharing €1,990 pp &nbsp;/&nbsp; Single €2,590 pp</p>
          <p style="margin-bottom: 14px;"><span class="tag">5 rooms</span></p>
          <p>Our most spacious accommodation, featuring a private jetted tub, sea views, and generous indoor living space.</p>
        </div>
        <div class="offering-card">
          <h3>Executive Suite with Sea View, 2 Bedrooms</h3>
          <p style="color: var(--terra); font-size: 0.95rem; margin-bottom: 10px;">Double occupancy (twin beds) €2,150 pp &nbsp;/&nbsp; Exclusive 2-guest occupancy €2,690 pp</p>
          <p style="margin-bottom: 14px;"><span class="tag">1 room</span></p>
          <p>A spacious 60 sqm suite featuring two bedrooms, two bathrooms, sea views, a kitchen, and a shared living area.</p>
        </div>
      </div>
      <p style="font-size: 0.84rem; color: var(--mocha); margin-top: 64px; text-align: center;">Room allocation is offered on a first-come, first-served basis.</p>
    </div>
  </section>

  <!-- ============================================================
       SECTION: Payment & Booking
       ============================================================ -->
  <section id="booking" style="background: var(--cream);">
    <div class="container" style="max-width: 760px;">
      <p class="section-label">Payment &amp; Booking</p>
      <h2 class="section-title">Securing your <em>place</em></h2>
      <p style="font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--terra); font-weight: 500; margin: 4px 0 8px;">Now open for booking</p>
      <div class="divider"></div>
      <p style="font-size: 0.95rem; line-height: 1.9; color: var(--mocha); margin-bottom: 32px;">A 50% non-refundable deposit is required to secure your place. The remaining balance is due by July 29, 2026. As accommodations and retreat arrangements are secured in advance and spaces are limited, all payments made toward the retreat are non-refundable. Should you be unable to attend, you may transfer your booking to another guest, subject to approval by SolScape Retreats. We strongly recommend purchasing travel insurance to protect against unforeseen circumstances. By making a payment, you acknowledge and accept these terms.</p>
      <div style="display: flex; gap: 14px; flex-wrap: wrap;">
        <a href="https://ig.me/m/solscape_retreats" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Message us on Instagram</a>
        <a href="https://mail.google.com/mail/?view=cm&fs=1&to=solscaperetreats@gmail.com" target="_blank" rel="noopener noreferrer" class="btn btn-outline">Email us</a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION: Other Retreats
       ============================================================ -->
  <section class="other-retreats" style="background: var(--linen);">
    <div class="container">
      <p class="section-label">More Destinations</p>
      <h2 class="section-title">Explore other <em>retreats</em></h2>
      <div class="other-retreat-cards">
        <div class="card">
          <div class="card-banner" style="background-image: url('https://images.unsplash.com/photo-1523805009345-7448845a9e53?auto=format&fit=crop&w=1200&q=80');">
            <div class="card-location"><small>East Africa</small>Kenya</div>
          </div>
          <div class="card-body">
            <p class="card-theme-name">wander</p>
            <p class="card-dates"><span class="card-status-dot"></span>Upcoming</p>
            <p class="card-desc">Wide-open landscapes, early morning movement, and days shaped by the rhythm of the wild.</p>
            <a href={`${base}/retreats/kenya`} class="card-link">Retreat details →</a>
          </div>
        </div>
        <div class="card">
          <div class="card-banner" style="background-image: url('https://images.unsplash.com/photo-1539020140153-e479b8c22e70?auto=format&fit=crop&w=1200&q=80');">
            <div class="card-location"><small>Atlas Mountains</small>Morocco</div>
          </div>
          <div class="card-body">
            <p class="card-theme-name">Rooted</p>
            <p class="card-dates"><span class="card-status-dot"></span>Upcoming</p>
            <p class="card-desc">Mountain air, quiet terraces, and movement woven into the warmth of Morocco.</p>
            <a href={`${base}/retreats/morocco`} class="card-link">Retreat details →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
