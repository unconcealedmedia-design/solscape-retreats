---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Morocco Retreat — SolScape Retreats" description="Set high above the Ourika Valley beneath the Atlas Mountains, our Morocco retreat is an invitation to reconnect through movement, beauty, and stillness. February 2027.">

  <!-- ============================================================
       SECTION: Hero
       ============================================================ -->
  <div class="detail-hero">
    <div class="hero-bg" style="background-image: url('https://images.unsplash.com/photo-1539020140153-e479b8c22e70?auto=format&fit=crop&w=1920&q=80');"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="sub">Atlas Mountains &nbsp;·&nbsp; Morocco</p>
      <h1>Morocco<br>Retreat</h1>
      <img src={`${base}/images/branding/solscape-logo.png`} class="hero-brand-mark" alt="SolScape">
    </div>
  </div>

  <!-- ============================================================
       SECTION: Overview
       ============================================================ -->
  <section style="background: var(--cream);">
    <div class="container" style="max-width: 760px; text-align: center;">
      <p class="section-label">Coming Soon</p>
      <h2 class="section-title">Reconnect through movement, <em>beauty, and stillness</em></h2>
      <div class="divider" style="margin: 28px auto;"></div>
      <p style="font-size: 1.05rem; line-height: 1.9; color: var(--mocha); margin-bottom: 24px;">Details coming soon. Set high above the Ourika Valley in the Atlas Mountains — sunrise yoga, slow mornings, and the warm rhythm of Moroccan culture. Register your interest below and be the first to know when it opens.</p>
      <p style="font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 1.2rem; color: var(--terra); letter-spacing: 0.03em;">rooted</p>
    </div>
  </section>

  <!-- ============================================================
       SECTION: Private Retreats
       ============================================================ -->
  <section style="background: var(--charcoal); padding: 80px 40px;">
    <div class="container" style="max-width: 760px; text-align: center;">
      <p class="section-label" style="color: var(--terra);">Bespoke Experiences</p>
      <h2 class="section-title" style="color: var(--linen);">Private Retreats <em style="color: var(--gold);">available upon request</em></h2>
      <div class="divider" style="margin: 28px auto; background: var(--terra); opacity: 0.45;"></div>
      <p style="font-size: 0.95rem; line-height: 1.9; color: var(--sand); margin-bottom: 32px;">Looking for a fully bespoke experience for your group? We create private SolScape retreats tailored entirely around you — your dates, your destination, your group. Reach out and let's design something unforgettable together.</p>
      <div style="display: flex; gap: 14px; flex-wrap: wrap; justify-content: center;">
        <a href="https://ig.me/m/solscape_retreats" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Message us on Instagram</a>
        <a href="https://mail.google.com/mail/?view=cm&fs=1&to=solscaperetreats@gmail.com" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">Email us</a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SECTION: Other Retreats
       ============================================================ -->
  <section class="other-retreats">
    <div class="container">
      <p class="section-label">More Destinations</p>
      <h2 class="section-title">Explore other <em>retreats</em></h2>
      <div class="other-retreat-cards">
        <div class="card">
          <div class="card-banner" style="background-image: url('https://images.unsplash.com/photo-1533105079780-92b9be482077?auto=format&fit=crop&w=1200&q=80');">
            <div class="card-location"><small>Peloponnese</small>Greece</div>
          </div>
          <div class="card-body">
            <p class="card-theme-name">exhale</p>
            <p class="card-dates"><span class="card-status-dot"></span>Upcoming — October 4–8, 2026</p>
            <p class="card-desc">Ancient stone villages, quiet coastlines, and daily movement where the mountains meet the sea.</p>
            <a href={`${base}/retreats/greece`} class="card-link">Retreat details →</a>
          </div>
        </div>
        <div class="card">
          <div class="card-banner" style="background-image: url('https://images.unsplash.com/photo-1499678329028-101435549a4e?auto=format&fit=crop&w=1200&q=80');">
            <div class="card-location"><small>Southern France</small>Provence</div>
          </div>
          <div class="card-body">
            <p class="card-theme-name">SoFen</p>
            <p class="card-dates"><span class="card-status-dot"></span>Upcoming</p>
            <p class="card-desc">Lavender fields, local markets, and slow movement beneath the spring light of Provence.</p>
            <a href={`${base}/retreats/provence`} class="card-link">Retreat details →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
