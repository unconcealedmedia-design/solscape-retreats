---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
---
<Layout title="SolScape Retreats" description="Retreats combining yoga, barre, breathwork, and movement in the world's most beautiful places.">

  <!-- HERO -->
  <section class="hero-full">
    <div class="hero-bg" style="background-image: url('https://images.unsplash.com/photo-1506126613408-eca07ce68773?auto=format&fit=crop&w=1920&q=80');"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1>SolScape<br><em>Retreats</em></h1>
      <p class="hero-tagline">Retreats in the world's most beautiful places</p>
      <div class="hero-actions">
        <a href="#retreats" class="btn btn-primary">View Upcoming Retreats</a>
        <a href={`${base}/about`} class="btn btn-ghost">Meet Samantha and Nada</a>
      </div>
    </div>
    <div class="hero-scroll">
      <div class="scroll-line"></div>
      <span>Scroll</span>
    </div>
  </section>

  <!-- MANIFESTO -->
  <div class="manifesto">
    <p class="manifesto-text">
      Nervous system reset.<br>
      <strong>This is where body, mind, and soul come home.</strong>
    </p>
    <p class="manifesto-sub">The pace.&nbsp; The people.&nbsp; The movement.&nbsp; The atmosphere.&nbsp; The shared meals.&nbsp; The feeling of being able to fully settle into where you are.</p>
  </div>

  <!-- EXPERIENCE CATEGORIES -->
  <section class="categories" id="experience">
    <div class="container">
      <div class="categories-header">
        <p class="section-label">How You'll Spend Your Days</p>
        <h2 class="section-title">The rhythm of a <em>SolScape Retreat</em></h2>
        <p class="section-body">Every Solscape Retreat is shaped around the details that make an experience feel genuinely good – movement, atmosphere, nature, conversation, nourishing meals, creativity, and time that doesn't feel rushed.</p>
      </div>
      <div class="categories-grid">

        <div class="cat-tile">
          <div class="cat-icon">
            <svg viewBox="0 0 40 40" fill="none" stroke="#CC9A67" stroke-width="1.4" stroke-linecap="round">
              <circle cx="20" cy="13" r="6"/>
              <path d="M10 35 Q20 24 30 35"/>
              <line x1="20" y1="19" x2="20" y2="28"/>
              <line x1="14" y1="26" x2="20" y2="28"/>
              <line x1="26" y1="26" x2="20" y2="28"/>
            </svg>
          </div>
          <span>Yoga</span>
        </div>

        <div class="cat-tile">
          <div class="cat-icon">
            <svg viewBox="0 0 40 40" fill="none" stroke="#CC9A67" stroke-width="1.4" stroke-linecap="round">
              <line x1="10" y1="8" x2="10" y2="34"/>
              <line x1="30" y1="8" x2="30" y2="34"/>
              <line x1="10" y1="16" x2="30" y2="16"/>
              <line x1="10" y1="23" x2="30" y2="23"/>
            </svg>
          </div>
          <span>Barre</span>
        </div>

        <div class="cat-tile">
          <div class="cat-icon">
            <svg viewBox="0 0 40 40" fill="none" stroke="#CC9A67" stroke-width="1.4" stroke-linecap="round">
              <line x1="20" y1="6" x2="20" y2="12"/>
              <path d="M20 12 C16 12 10 14 10 21 C10 27 14 33 19 32 C20 32 20 28 20 25"/>
              <path d="M20 12 C24 12 30 14 30 21 C30 27 26 33 21 32 C20 32 20 28 20 25"/>
            </svg>
          </div>
          <span>Breathwork</span>
        </div>

        <div class="cat-tile">
          <div class="cat-icon">
            <svg viewBox="0 0 40 40" fill="none" stroke="#CC9A67" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              <line x1="20" y1="33" x2="20" y2="24"/>
              <path d="M9 30 L20 10 L31 30 Z"/>
            </svg>
          </div>
          <span>Nature</span>
        </div>

        <div class="cat-tile">
          <div class="cat-icon">
            <svg viewBox="0 0 40 40" fill="none" stroke="#CC9A67" stroke-width="1.4" stroke-linecap="round">
              <line x1="12" y1="8" x2="12" y2="14"/>
              <line x1="15" y1="8" x2="15" y2="14"/>
              <line x1="18" y1="8" x2="18" y2="14"/>
              <path d="M12 14 Q15 17 18 14"/>
              <line x1="15" y1="17" x2="15" y2="32"/>
              <path d="M25 8 C29 8 29 16 25 16"/>
              <line x1="25" y1="8" x2="25" y2="32"/>
            </svg>
          </div>
          <span>Shared Tables</span>
        </div>

        <div class="cat-tile">
          <div class="cat-icon">
            <svg viewBox="0 0 40 40" fill="none" stroke="#CC9A67" stroke-width="1.4" stroke-linecap="round">
              <line x1="30" y1="7" x2="18" y2="22"/>
              <line x1="20" y1="20" x2="16" y2="24"/>
              <path d="M18 22 Q13 27 11 33 Q16 30 18 22"/>
            </svg>
          </div>
          <span>Creative Exploration</span>
        </div>

        <div class="cat-tile">
          <div class="cat-icon">
            <svg viewBox="0 0 40 40" fill="none" stroke="#CC9A67" stroke-width="1.4" stroke-linecap="round">
              <circle cx="10" cy="20" r="2" fill="#CC9A67" stroke="none"/>
              <path d="M15 15 Q19 20 15 25"/>
              <path d="M20 11 Q26 20 20 29"/>
              <path d="M25 8 Q33 20 25 32"/>
            </svg>
          </div>
          <span>Sound</span>
        </div>

        <div class="cat-tile">
          <div class="cat-icon">
            <svg viewBox="0 0 40 40" fill="none" stroke="#CC9A67" stroke-width="1.4" stroke-linecap="round">
              <circle cx="13" cy="16" r="4.5"/>
              <circle cx="27" cy="16" r="4.5"/>
              <path d="M5 34 Q13 26 20 28 Q27 26 35 34"/>
            </svg>
          </div>
          <span>Community</span>
        </div>

      </div>
    </div>
  </section>

  <!-- WHY TRAVEL WITH US -->
  <section class="why-us" style="min-height: 420px; padding: 180px 40px 56px; display: flex; flex-direction: column; justify-content: flex-start;">
    <div class="container" style="max-width: 820px; text-align: center; padding: 0 24px;">
      <h2 class="section-title">Why people travel <em>with us?</em></h2>
      <div class="divider" style="margin: 28px auto;"></div>
      <p style="font-size: 1rem; line-height: 1.95; color: var(--mocha); max-width: 620px; margin: 0 auto;">At Solscape Retreats, you feel supported and grounded in spaces that are intentional – experiences where you can move, explore and reconnect.</p>
    </div>
  </section>

  <!-- RETREATS -->
  <section class="retreats" id="retreats">
    <div class="container">
      <div class="retreats-header">
        <div>
          <p class="section-label">Upcoming Retreats</p>
          <h2 class="section-title">Places we're <em>gathering</em></h2>
          <p class="section-body" style="margin-top: 12px;">Each retreat is chosen for its setting, atmosphere, movement possibilities and the feeling it allows us to create.</p>
        </div>
        <a href={`${base}/about`} class="btn btn-outline">Our Story</a>
      </div>
      <div class="retreat-cards">

        <div class="card">
          <div class="card-banner" style={`background-image: url('${base}/images/destinations/greece-peloponnese-coast.jpg');`}>
            <div class="card-location">
              <small>Peloponnese</small>
              Greece
            </div>
          </div>
          <div class="card-body">
            <p class="card-theme-name">exhale</p>
            <p class="card-dates"><span class="card-status-dot"></span>Upcoming — October 4–8, 2026</p>
            <p class="card-desc">Coastal mornings, village walks, movement, shared meals, and days shaped by the quieter rhythm of the Peloponnese.</p>
            <div class="card-tags">
              <span class="tag">Yoga</span>
              <span class="tag">Barre</span>
              <span class="tag">Monemvasia</span>
            </div>
            <a href={`${base}/retreats/greece`} class="card-link">Retreat Details →</a>
          </div>
        </div>

        <div class="card">
          <div class="card-banner" style="background-image: url('https://images.unsplash.com/photo-1547471080-7cc2caa01a7e?auto=format&fit=crop&w=1200&q=80');">
            <div class="card-location">
              Kenya
            </div>
          </div>
          <div class="card-body">
            <p class="card-theme-name">wander</p>
            <p class="card-dates"><span class="card-status-dot"></span>Upcoming — Dates TBA</p>
            <p class="card-desc">Open landscapes, early morning movement, thoughtful conversation and the rare feeling of being fully present in the world around you.</p>
            <div class="card-tags">
              <span class="tag">Nature</span>
              <span class="tag">Yoga</span>
              <span class="tag">Barre</span>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-banner" style="background-image: url('https://images.unsplash.com/photo-1684100096410-fd39cdff91a3?auto=format&fit=crop&w=1200&q=80');">
            <div class="card-location">
              <small>Luxor &amp; Aswan</small>
              Egypt
            </div>
          </div>
          <div class="card-body">
            <p class="card-theme-name">drift</p>
            <p class="card-dates"><span class="card-status-dot"></span>Upcoming — Dates TBA</p>
            <p class="card-desc">A journey along the Nile shaped by movement, ancient history, golden light and life on the water.</p>
            <div class="card-tags">
              <span class="tag">Culture</span>
              <span class="tag">Movement</span>
              <span class="tag">Nile Journey</span>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-banner" style="background-image: url('https://images.unsplash.com/photo-1539020140153-e479b8c22e70?auto=format&fit=crop&w=1200&q=80');">
            <div class="card-location">
              <small>Atlas Mountains</small>
              Morocco
            </div>
          </div>
          <div class="card-body">
            <p class="card-theme-name">rooted</p>
            <p class="card-dates"><span class="card-status-dot"></span>Upcoming — Dates TBA</p>
            <p class="card-desc">Mountain air, quiet terraces, and movement woven into the warmth of Morocco.</p>
            <div class="card-tags">
              <span class="tag">Breathwork</span>
              <span class="tag">Culture</span>
              <span class="tag">Nature</span>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-banner" style={`background-image: url('${base}/images/destinations/provence-lavender-field.jpg');`}>
            <div class="card-location">
              <small>Southern France</small>
              Provence
            </div>
          </div>
          <div class="card-body">
            <p class="card-theme-name">savor</p>
            <p class="card-dates"><span class="card-status-dot"></span>Upcoming — Dates TBA</p>
            <p class="card-desc">Markets, movement, long tables, spring light and slow days woven through the villages of Provence.</p>
            <div class="card-tags">
              <span class="tag">Movement</span>
              <span class="tag">Shared Tables</span>
              <span class="tag">Creative Exploration</span>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-banner" style="background-image: url('https://images.unsplash.com/photo-1506905925346-21bda4d32df4?auto=format&fit=crop&w=1200&q=80');">
            <div class="card-location">
              <small>Swiss Alps</small>
              Geneva
            </div>
          </div>
          <div class="card-body">
            <p class="card-theme-name">reflection</p>
            <p class="card-dates"><span class="card-status-dot"></span>Upcoming — Dates TBA</p>
            <p class="card-desc">Alpine air, mountain stillness, and restorative movement shaped by the rhythm of summer in the Alps.</p>
            <div class="card-tags">
              <span class="tag">Nature</span>
              <span class="tag">Barre</span>
              <span class="tag">Breathwork</span>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-banner" style="background-image: url('https://images.unsplash.com/photo-1504457047772-27faf1c00561?auto=format&fit=crop&w=1200&q=80');">
            <div class="card-location">
              <small>Destination TBA</small>
              Exotic
            </div>
          </div>
          <div class="card-body">
            <p class="card-theme-name">expansive</p>
            <p class="card-dates"><span class="card-status-dot"></span>Upcoming — Dates TBA</p>
            <p class="card-desc">A stunning location, off the beaten track. Details coming soon.</p>
            <div class="card-tags">
              <span class="tag">Adventure</span>
              <span class="tag">Movement</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- WHAT'S INCLUDED -->
  <section id="included">
    <div class="container">
      <p class="section-label">Everything You Need</p>
      <h2 class="section-title">What's <em>included</em></h2>
      <div class="divider"></div>
      <div class="includes-grid">

        <div class="include-item">
          <div class="include-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <circle cx="12" cy="12" r="5"/>
              <line x1="12" y1="1" x2="12" y2="3"/>
              <line x1="12" y1="21" x2="12" y2="23"/>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
              <line x1="1" y1="12" x2="3" y2="12"/>
              <line x1="21" y1="12" x2="23" y2="12"/>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
            </svg>
          </div>
          <div>
            <h4>Daily Yoga &amp; Barre</h4>
            <p>Movement is the foundation of every retreat – supportive, intelligent sessions designed to help people feel energized, grounded and connected throughout the day.</p>
          </div>
        </div>

        <div class="include-item">
          <div class="include-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <path d="M3 18 Q5 12 12 12 Q19 12 21 18"/>
              <path d="M8 12 Q8 6 12 5 Q16 6 16 12"/>
            </svg>
          </div>
          <div>
            <h4>Nourishing Meals</h4>
            <p>Meals are an important part of the retreat experience – fresh, seasonal food, chosen to support energy, movement, rest and feeling well throughout the day.</p>
          </div>
        </div>

        <div class="include-item">
          <div class="include-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <circle cx="6" cy="12" r="1.2" fill="currentColor" stroke="none"/>
              <path d="M10 9 Q12.5 12 10 15"/>
              <path d="M13 7 Q17 12 13 17"/>
              <path d="M16 5 Q22 12 16 19"/>
            </svg>
          </div>
          <div>
            <h4>Sound Baths</h4>
            <p>Immersive sound healing that settles the nervous system – resonant tones to help you drop into deep rest and stillness.</p>
          </div>
        </div>

        <div class="include-item">
          <div class="include-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <path d="M12 2C12 2 6 8 6 14 C6 17.3 8.7 20 12 20 C15.3 20 18 17.3 18 14 C18 8 12 2 12 2Z"/>
              <path d="M9 11 Q12 15 15 11"/>
            </svg>
          </div>
          <div>
            <h4>Breathwork &amp; Meditation</h4>
            <p>Simple guided practices woven naturally into the retreat experience, creating space to slow down, breathe deeply and become more present.</p>
          </div>
        </div>

        <div class="include-item">
          <div class="include-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <path d="M3 17 L21 17"/>
              <path d="M3 17 Q3 12 8 10 Q12 8 12 8 Q12 8 16 10 Q21 12 21 17"/>
              <path d="M12 8 L12 4"/>
            </svg>
          </div>
          <div>
            <h4>Excursions &amp; Experiences</h4>
            <p>We choose experiences carefully – walks, villages, coastlines, local culture and moments that allow us to genuinely connect to the places we go.</p>
          </div>
        </div>

        <div class="include-item">
          <div class="include-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="8" cy="9" r="2.6"/>
              <circle cx="16" cy="9" r="2.6"/>
              <path d="M3 19 Q8 14 12 16 Q16 14 21 19"/>
            </svg>
          </div>
          <div>
            <h4>Small Group Setting</h4>
            <p>Intentionally small groups, so the days stay intimate and unhurried – the kind of company that feels like old friends by day two.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="testimonials">
    <div class="container">
      <p class="section-label">Voices from Past Retreats</p>
      <h2 class="section-title" style="color: var(--linen);">What they <em style="color: var(--gold);">say</em></h2>
      <div class="testimonial-carousel">
        <div class="testimonial-track">

          <div class="testimonial-slide">
            <div class="testimonial-card">
              <p class="testimonial-quote">"I came to reset and left completely transformed. The combination of movement, breathwork, and the sheer beauty of the landscape made this unlike any holiday I've ever taken."</p>
              <p class="testimonial-author">Retreat Guest &nbsp;·&nbsp; Greece &nbsp;·&nbsp; 2024</p>
            </div>
          </div>

          <div class="testimonial-slide">
            <div class="testimonial-card">
              <p class="testimonial-quote">"Nada and Samantha created something truly special. The group was small enough that it felt like travelling with old friends by day two. The barre sessions were tough and wonderful."</p>
              <p class="testimonial-author">Retreat Guest &nbsp;·&nbsp; Egypt &nbsp;·&nbsp; 2024</p>
            </div>
          </div>

          <div class="testimonial-slide">
            <div class="testimonial-card">
              <p class="testimonial-quote">"I was sceptical about a retreat — but SolScape completely changed my mind. The structure, the pace, the food, the people. I'm already counting down to the next one."</p>
              <p class="testimonial-author">Retreat Guest &nbsp;·&nbsp; Spain &nbsp;·&nbsp; 2025</p>
            </div>
          </div>

        </div>
        <div class="carousel-dots">
          <button class="carousel-dot active"></button>
          <button class="carousel-dot"></button>
          <button class="carousel-dot"></button>
        </div>
      </div>
    </div>
  </section>

  <!-- SUSTAINABILITY -->
  <section class="sustainability">
    <div class="container">
      <div class="sustainability-header">
        <p class="section-label">Our Commitment</p>
        <h2 class="section-title">Travel that <em>gives back</em></h2>
        <p class="section-body">We believe beautiful places deserve to stay beautiful. Every SolScape retreat is built around responsible, low-impact travel.</p>
      </div>
      <div class="sus-grid">

        <div class="sus-item">
          <div class="sus-icon">
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none" stroke="#CC9A67" stroke-width="1.4" stroke-linecap="round">
              <path d="M20 6 Q28 10 28 20 Q28 30 20 34 Q12 30 12 20 Q12 10 20 6Z"/>
              <path d="M20 14 Q24 17 24 22 Q24 27 20 29 Q16 27 16 22 Q16 17 20 14Z" fill="#CC9A67" opacity="0.15"/>
              <line x1="20" y1="6" x2="20" y2="4"/>
            </svg>
          </div>
          <h4>Eco Partnerships</h4>
          <p>We work exclusively with properties that practise responsible, ecological tourism.</p>
        </div>

        <div class="sus-item">
          <div class="sus-icon">
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none" stroke="#CC9A67" stroke-width="1.4" stroke-linecap="round">
              <circle cx="13" cy="16" r="5"/>
              <circle cx="27" cy="16" r="5"/>
              <path d="M5 34 Q13 26 20 28 Q27 26 35 34"/>
            </svg>
          </div>
          <h4>Intentionally Small</h4>
          <p>Small groups mean lighter footprints, deeper connections, and more meaningful experiences.</p>
        </div>

        <div class="sus-item">
          <div class="sus-icon">
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none" stroke="#CC9A67" stroke-width="1.4" stroke-linecap="round">
              <path d="M20 6 L23 14 L32 14 L25 19 L28 28 L20 23 L12 28 L15 19 L8 14 L17 14 Z"/>
            </svg>
          </div>
          <h4>2% Give Back</h4>
          <p>Two percent of every booking goes directly to local reforestation and conservation projects.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA BAND -->
  <section class="cta-band">
    <h2>Ready to <em>reset<br>properly?</em></h2>
    <p>Spaces are limited and fill quickly. Reach out to learn more or to save your spot on an upcoming retreat.</p>
    <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
      <a href="https://ig.me/m/solscape_retreats" target="_blank" class="btn btn-primary" rel="noopener noreferrer">Message Us on Instagram</a>
      <a href="mailto:solscaperetreats@gmail.com?subject=Retreat%20Enquiry" target="_blank" class="btn btn-outline" rel="noopener noreferrer">Send an Inquiry</a>
    </div>
  </section>

</Layout>
