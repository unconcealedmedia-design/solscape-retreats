---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
---
<Layout title="Contact — SolScape Retreats" description="Get in touch with SolScape Retreats. Ask a question, register interest, or send an enquiry about upcoming retreats.">

  <!-- ============================================================
       SECTION: Hero
       ============================================================ -->
  <div class="contact-hero">
    <h1>We'd love to<br><em>hear from you</em></h1>
    <p>Questions, retreat enquiries, or just curious — reach out and we'll get back to you soon.</p>
  </div>

  <!-- ============================================================
       SECTION: Get in touch — Instagram DM + email only.
       No forms: the site is on GitHub Pages, which can't receive them.
       ============================================================ -->
  <section class="contact-form-section">
    <div class="container" style="max-width: 760px; text-align: center;">
      <div style="display: flex; gap: 14px; flex-wrap: wrap; justify-content: center;">
        <a href="https://ig.me/m/solscape_retreats" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Message us on Instagram</a>
        <a href="mailto:solscaperetreats@gmail.com?subject=Retreat%20Enquiry" target="_blank" rel="noopener noreferrer" class="btn btn-outline">Email us</a>
      </div>
      <p style="margin-top: 24px; font-size: 0.95rem; color: var(--mocha);">solscaperetreats@gmail.com</p>
    </div>
  </section>

</Layout>
