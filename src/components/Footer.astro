---
const base = import.meta.env.BASE_URL;
const { showNewsletter = true } = Astro.props;
---
<footer>
  <div class="footer-inner">
    <div class="footer-brand">
      <img src={`${base}/images/branding/solscape-logo.png`} class="footer-logo-img" alt="SolScape Retreats">
      <p class="footer-tagline">Retreats in the world's most beautiful places.</p>
    </div>
    <div class="footer-col">
      <h5>Retreats</h5>
      <ul>
        <li><a href={`${base}/retreats/greece`}>Greece</a></li>
        <li><a href={`${base}/retreats/kenya`}>Kenya</a></li>
        <li><a href={`${base}/retreats/morocco`}>Morocco</a></li>
        <li><a href={`${base}/retreats/provence`}>Provence</a></li>
        <li><a href={`${base}/retreats/geneva`}>Geneva</a></li>
        <li><a href={`${base}/retreats/exotic`}>Exotic — TBA</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h5>Explore</h5>
      <ul>
        <li><a href={`${base}/experience`}>The Experience</a></li>
        <li><a href={`${base}/about`}>About Us</a></li>
        <li><a href={`${base}/contact`}>Contact</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h5>Connect</h5>
      <ul>
        <li><a href="https://www.instagram.com/solscape_retreats/" target="_blank" rel="noopener noreferrer">Instagram</a></li>
        <li><a href="https://ig.me/m/solscape_retreats" target="_blank" rel="noopener noreferrer">DM to Book</a></li>
        {showNewsletter && <li><a href={`${base}/contact`}>Newsletter</a></li>}
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <p class="footer-copy">© 2026 SolScape Retreats &nbsp;·&nbsp; All rights reserved</p>
    <div class="footer-social">
      <a href="https://www.instagram.com/solscape_retreats/" target="_blank" aria-label="Instagram" rel="noopener noreferrer">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>
        </svg>
      </a>
      <a href="mailto:solscaperetreats@gmail.com?subject=Retreat%20Enquiry" target="_blank" aria-label="Email" rel="noopener noreferrer">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="2"/>
          <polyline points="2,4 12,13 22,4"/>
        </svg>
      </a>
    </div>
  </div>
</footer>
