---
const base = import.meta.env.BASE_URL;
---
<nav>
  <a href={`${base}/`} class="logo">
    <img src={`${base}/images/branding/solscape-logo.png`} alt="SolScape Retreats" class="logo-img">
  </a>
  <ul class="nav-links">
    <li class="nav-item has-dropdown">
      <a href={`${base}/#retreats`}>Retreats</a>
      <ul class="dropdown">
        <li><a href={`${base}/retreats/greece`}>Greece</a></li>
        <li><a href={`${base}/retreats/kenya`}>Kenya</a></li>
        <li><a href={`${base}/retreats/egypt-nile`}>Luxor Aswan</a></li>
        <li><a href={`${base}/retreats/morocco`}>Morocco</a></li>
        <li><a href={`${base}/retreats/provence`}>Provence</a></li>
        <li><a href={`${base}/retreats/geneva`}>Geneva</a></li>
        <li><a href={`${base}/retreats/exotic`}>Exotic — TBA</a></li>
      </ul>
    </li>
    <li class="nav-item"><a href={`${base}/experience`}>Experience</a></li>
    <li class="nav-item"><a href={`${base}/about`}>About</a></li>
    <li class="nav-item"><a href={`${base}/contact`}>Contact</a></li>
  </ul>
  <div class="nav-actions">
    <a href="https://www.instagram.com/solscape_retreats/" target="_blank" class="nav-insta" aria-label="Instagram" rel="noopener noreferrer">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>
      </svg>
    </a>
    <a href="https://ig.me/m/solscape_retreats" target="_blank" class="nav-cta" rel="noopener noreferrer">Book Now</a>
  </div>
  <button class="hamburger" aria-label="Menu"><span></span><span></span><span></span></button>
</nav>

<div class="mobile-menu">
  <ul>
    <li><a href={`${base}/retreats/greece`}>Greece</a></li>
    <li><a href={`${base}/retreats/kenya`}>Kenya</a></li>
    <li><a href={`${base}/retreats/egypt-nile`}>Luxor Aswan</a></li>
    <li><a href={`${base}/retreats/morocco`}>Morocco</a></li>
    <li><a href={`${base}/retreats/provence`}>Provence</a></li>
    <li><a href={`${base}/retreats/geneva`}>Geneva</a></li>
    <li><a href={`${base}/retreats/exotic`}>Exotic — TBA</a></li>
    <li><a href={`${base}/experience`}>Experience</a></li>
    <li><a href={`${base}/about`}>About</a></li>
    <li><a href={`${base}/contact`}>Contact</a></li>
  </ul>
  <a href="https://ig.me/m/solscape_retreats" target="_blank" class="btn btn-primary" rel="noopener noreferrer">Book Now</a>
</div>
